# A hosted viewer: the Viser scene server, in the cloud, so the crowd has a URL.
#
# This is a demo convenience and not the architecture. The renderer is still the browser;
# what moves here is the scene bookkeeping that normally runs on the player's machine. The
# cost of moving it is that the last hop stops being weft's 22-byte wire and becomes Viser's
# own protocol, which nobody has measured. See proto/README.md for where things belong.
FROM python:3.12-slim
RUN pip install --no-cache-dir viser trimesh numpy websockets zstandard
WORKDIR /view
COPY proto/client.py proto/entity_packet.py ./proto/
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/view
ENV PLANE=wss://weft-room.fly.dev
ENV VISER_PORT=8080
EXPOSE 8080
CMD ["python3", "proto/client.py"]
